# Copy to .env and fill in from Firebase console → Project settings → Your apps → Web app.
# These are public identifiers, not secrets, but keep .env out of git anyway (it is gitignored)
# and restrict the API key to your domains / app IDs in Google Cloud console.
# Leave them empty to run in demo mode: data stays on the device and accounts/sync are simulated.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key for Firebase App Check (web)
VITE_RECAPTCHA_ENTERPRISE_KEY=
# Local development only: App Check debug token (never set in production builds)
VITE_APPCHECK_DEBUG_TOKEN=
